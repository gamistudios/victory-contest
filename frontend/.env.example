# Backend API base URL (empty = same origin as the frontend)
VITE_API_BASE_URL=http://localhost:8080

# Public frontend origin used for article share links.
# Empty/unset = window.location.origin (correct for same-origin deploys).
# Set it when the share link must point at a different domain.
VITE_FRONTEND_URL=

# Telegram bot username used by the Academy referral deep link
# (t.me/<bot>?startapp=ref_<studentId>_<moduleId>). Must be the bot that opens
# this mini app, otherwise the share link goes nowhere.
VITE_TELEGRAM_BOT_USERNAME=VictoryLearningBot
