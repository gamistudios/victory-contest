# Backend API base URL (empty = same origin as the frontend)
VITE_API_BASE_URL=http://localhost:8080

# Public frontend origin used for article share links.
# Empty/unset = window.location.origin (correct for same-origin deploys).
# Set it when the share link must point at a different domain.
VITE_FRONTEND_URL=

# Fallback Telegram bot username for the t.me/<bot> links (Academy referral
# invite, article preview URL). Leave this UNSET in normal operation: the app
# asks the API (GET /telegram/bot), which answers with the bot its own
# TELEGRAM_BOT_TOKEN actually belongs to, so a renamed bot needs no frontend
# change. Only used when that call cannot be answered - bot disabled
# server-side, or an offline dev build pointed at a stub API.
VITE_TELEGRAM_BOT_USERNAME=
