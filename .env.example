# Victory Contest Platform - Environment Variables
# Copy this file to .env and fill in your actual values

# ============================================
# REQUIRED VARIABLES
# ============================================

# JWT Secret - CHANGE THIS to a long random string
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-characters

# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key-here
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key-here

# DynamoDB Table Names
QUESTION_TABLE=question
CONTEST_TABLE=contests
STUDENT_TABLE=student
SUBMISSION_TABLE=submissions
ADMIN_TABLE=admin
NOTIFICATION_TABLE=notification
ACHIEVEMENT_TABLE=achievement
CONTEST_REGISTRATION_TABLE=contest_registeration

# ============================================
# OPTIONAL VARIABLES
# ============================================

# Cloudinary (for image uploads)
# Format: cloudinary://api_key:api_secret@cloud_name
CLOUDINARY_URL=

# Google API (for AI features)
GOOGLE_API_KEY=

# Telegram Bot Integration
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Full public webhook URL Telegram should POST updates to. When set, the API
# auto-registers it at boot (getWebhookInfo first, setWebhook only when unset
# or changed). Example: https://your-app.koyeb.app/api/telegram/webhook
TELEGRAM_WEBHOOK_URL=

# Public origin of the contest mini-app frontend; used by the Telegram bot's
# /start "Open Contest" button. Example: https://victory-contest.vercel.app
FRONTEND_URL=

# CORS Configuration
# Comma-separated list of allowed origins (no spaces)
# Example: https://yourdomain.com,https://admin.yourdomain.com
# Leave empty for localhost development
CORS_ALLOWED_ORIGINS=

# Development Auth (NEVER set to true in production)
ALLOW_DEV_AUTH=false

# AI Rate Limiting (requests per minute per IP)
AI_REQUESTS_PER_MINUTE=30

# Port (default: 8080)
PORT=8080
