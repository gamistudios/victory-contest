GOOGLE_API_KEY=AIxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxGFdA
TELEGRAM_BOT_TOKEN=123456789:xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
JWT_SECRET=change-me-to-a-long-random-string
# AWS Configuration
AWS_REGION=eu-xxxx-1
AWS_ACCESS_KEY_ID=AXXXXXXXXXXXXXXJ
AWS_SECRET_ACCESS_KEY=rxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxH
# Database Tables
QUESTION_TABLE=question
CONTEST_TABLE=contests
STUDENT_TABLE=student
SUBMISSION_TABLE=submissions
ADMIN_TABLE=admin
NOTIFICATION_TABLE=notification
ACHIEVEMENT_TABLE=achievement
CONTEST_REGISTRATION_TABLE=contest_registeration
# CORS: comma-separated list of exact origins allowed to send credentialed
# cross-origin requests (scheme://host[:port], no trailing slash).
# REQUIRED in production, e.g.:
#   CORS_ALLOWED_ORIGINS=https://victory-contest.vercel.app,https://victory-admin-page.vercel.app
# When unset (local dev default) only http/https origins on localhost or
# 127.0.0.1 (any port) are allowed; *.devtunnels.ms is never allowed.
CORS_ALLOWED_ORIGINS=
# Dev escape hatch for Telegram session auth (S2): when true, POST
# /api/telegram/auth/dev mints student session tokens for ANY client-declared
# user_id with NO initData signature check. Leave unset/false in production.
ALLOW_DEV_AUTH=false
