CLOUDINARY_URL=cloudinary://7xxxxxxxxxx67:yQxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxt1ptn
GOOGLE_API_KEY=AIxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxGFdA
TELEGRAM_BOT_TOKEN=123456789:xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_WEBHOOK_SECRET=
# Full public webhook URL; auto-registered via setWebhook at boot when set.
# MUST include the /api/telegram/webhook path.
# Example: https://your-app.koyeb.app/api/telegram/webhook
TELEGRAM_WEBHOOK_URL=
# Public origin of the contest mini-app frontend; used by the /start WebApp
# button (defaults to https://victory-contest.vercel.app when unset)
# Example: https://victory-contest.vercel.app
FRONTEND_URL=
JWT_SECRET=change-me-to-a-long-random-string
# AWS Configuration
AWS_REGION=eu-xxxx-1
AWS_ACCESS_KEY_ID=AXXXXXXXXXXXXXXJ
AWS_SECRET_ACCESS_KEY=rxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxH
# Database Tables
QUESTION_TABLE=question
CONTEST_TABLE=contests
STUDENT_TABLE=student
SUBMISSION_TABLE=submissions
ADMIN_TABLE=admin
NOTIFICATION_TABLE=notification
ACHIEVEMENT_TABLE=achievement
CONTEST_REGISTRATION_TABLE=contest_registeration
# CORS: comma-separated list of exact origins allowed to send credentialed
# cross-origin requests (scheme://host[:port], no trailing slash).
# REQUIRED in production, e.g.:
#   CORS_ALLOWED_ORIGINS=https://victory-contest.vercel.app,https://victory-admin-page.vercel.app
# When unset (local dev default) only http/https origins on localhost or
# 127.0.0.1 (any port) are allowed; *.devtunnels.ms is never allowed.
CORS_ALLOWED_ORIGINS=
# Dev escape hatch for Telegram session auth (S2): when true, POST
# /api/telegram/auth/dev mints student session tokens for ANY client-declared
# user_id with NO initData signature check. Leave unset/false in production.
ALLOW_DEV_AUTH=false

# ---- Auto data migrations (phase 0/1) ----
# Data migrations run on boot in ID order; AUTO_MIGRATE=off|false|0 skips them.
# Never leave the runner on for an instance that points at production tables
# unless the data changes (grade rewrite, enrollment backfill) are intended.
AUTO_MIGRATE=on
# JSON backup dir written before any row changes (default: migration-backups).
MIGRATION_BACKUP_DIR=migration-backups/
# -004 default "All access" plan: price in whole ETB birr (e.g. 299 = 299 ETB);
# unset keeps the migration deferred. Validity days default to 30.
MIGRATE_PRICING_ETB=
MIGRATE_PRICING_DAYS=30
